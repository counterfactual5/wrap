{
  "connector__matrix__generate_image": {
    "name": "connector__matrix__generate_image",
    "input_schema": {
      "type": "object",
      "required": [
        "requests"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string"
              },
              "aspect_ratio": {
                "type": "string"
              },
              "area": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ]
              },
              "output_file": {
                "type": "string"
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg",
                  "jpg"
                ]
              },
              "reference_images": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "mime_type": {
                      "type": "string",
                      "enum": [
                        "image/jpeg",
                        "image/png",
                        "image/webp",
                        "image/heic",
                        "image/heif"
                      ]
                    }
                  }
                }
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "model": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "connector__matrix__submit_video_generation": {
    "name": "connector__matrix__submit_video_generation",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "duration": {
          "type": "integer"
        },
        "ratio": {
          "type": "string",
          "enum": [
            "adaptive",
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "480P",
            "768P",
            "1080P",
            "2K"
          ]
        },
        "input_image": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "mime_type": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "reference_type": {
          "type": "string",
          "enum": [
            "first_frame",
            "last_frame",
            "subject"
          ]
        },
        "last_frame_image": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "mime_type": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "reference_images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "mime_type": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "reference_videos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3
        },
        "reference_audios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3
        }
      }
    }
  }
}
