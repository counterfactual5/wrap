{
  "connector__matrix__generate_image": {
    "name": "connector__matrix__generate_image",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "area": {
                "description": "Output size tier used with aspect_ratio; defaults to 4K.",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "type": "string"
              },
              "aspect_ratio": {
                "description": "\"auto\" or \"X:Y\" with integers 1-300 between 1:3 and 3:1, for example 16:9. Use with optional area.",
                "type": "string"
              },
              "n": {
                "description": "Number of images for this request; defaults to 1. Each delivered image is charged once.",
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              "output_file": {
                "description": "Optional downloaded base filename. Directory components are ignored.",
                "minLength": 1,
                "type": "string"
              },
              "output_format": {
                "description": "Defaults to jpeg. jpg is the same as jpeg.",
                "enum": [
                  "png",
                  "jpeg",
                  "jpg"
                ],
                "type": "string"
              },
              "prompt": {
                "description": "Image description. With reference_images, refer to them as \u56fe1, \u56fe2, ... in the order given.",
                "minLength": 1,
                "type": "string"
              },
              "reference_images": {
                "description": "Optional 1-16 reference images to edit or combine. JPG, JPEG, PNG, WEBP, HEIC or HEIF; each at most 64 MB, 128-8192 px per side, aspect ratio at most 4:1.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "mime_type": {
                      "enum": [
                        "image/jpeg",
                        "image/png",
                        "image/webp",
                        "image/heic",
                        "image/heif"
                      ],
                      "type": "string"
                    },
                    "url": {
                      "description": "temp_url from a completed upload_temp_url upload (upload local files first), or an existing upload URL from this environment.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url"
                  ],
                  "type": "object"
                },
                "maxItems": 16,
                "type": "array"
              }
            },
            "required": [
              "prompt"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "requests"
      ],
      "type": "object"
    }
  },
  "connector__matrix__submit_video_generation": {
    "name": "connector__matrix__submit_video_generation",
    "input_schema": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-Hailuo-2.3"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reference_images"
                  ]
                },
                {
                  "required": [
                    "reference_videos"
                  ]
                },
                {
                  "required": [
                    "reference_audios"
                  ]
                },
                {
                  "required": [
                    "last_frame_image"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-H3-Max"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reference_images"
                  ]
                },
                {
                  "required": [
                    "reference_videos"
                  ]
                },
                {
                  "required": [
                    "reference_audios"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-H3"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "maximum": 15,
                "minimum": 4,
                "type": "integer"
              },
              "ratio": {
                "enum": [
                  "adaptive",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "resolution": {
                "default": "2K",
                "enum": [
                  "768P",
                  "2K"
                ]
              }
            },
            "required": [
              "duration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-H3-Max"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "maximum": 15,
                "minimum": 5,
                "type": "integer"
              },
              "ratio": {
                "enum": [
                  "adaptive",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "resolution": {
                "default": "768P",
                "enum": [
                  "480P",
                  "768P"
                ]
              }
            },
            "required": [
              "duration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-Hailuo-2.3"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "default": 6,
                "enum": [
                  6,
                  10
                ]
              },
              "prompt": {
                "maxLength": 3000
              },
              "resolution": {
                "default": "768P",
                "enum": [
                  "768P",
                  "1080P"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "MiniMax-Hailuo-2.3"
              },
              "reference_type": {
                "const": "subject"
              }
            },
            "required": [
              "model",
              "reference_type"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "const": 6,
                "default": 6
              }
            }
          }
        }
      ],
      "properties": {
        "duration": {
          "description": "MiniMax-H3: required integer from 4 through 15. MiniMax-H3-Max: required integer from 5 through 15. MiniMax-Hailuo-2.3: 6 (default) or 10; legacy subject mode supports 6 only.",
          "type": "integer"
        },
        "input_image": {
          "additionalProperties": false,
          "description": "One .jpg, .jpeg, .png, .webp, .heic, or .heif keyframe or single reference image supplied by URL. MiniMax-H3 accepts up to 30 MB, dimensions 256-5760 pixels, and aspect ratio 0.4-2.5. Use with reference_type for keyframe generation; cannot be combined with reference collections.",
          "properties": {
            "mime_type": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp",
                "image/heic",
                "image/heif"
              ],
              "type": "string"
            },
            "url": {
              "description": "Use temp_url after completing upload_temp_url, or an existing upload URL from this environment.",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "last_frame_image": {
          "additionalProperties": false,
          "description": "MiniMax-H3 / MiniMax-H3-Max first+last-frame mode only. One ending-frame image URL with the same limits as input_image. Requires input_image; no reference collections.",
          "properties": {
            "mime_type": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp",
                "image/heic",
                "image/heif"
              ],
              "type": "string"
            },
            "url": {
              "description": "Use temp_url after completing upload_temp_url, or an existing upload URL from this environment.",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "model": {
          "description": "Required. MiniMax-H3: recommended quality. MiniMax-H3-Max: fast (~20s), keyframes only, 480P/768P. MiniMax-Hailuo-2.3: lower cost.",
          "enum": [
            "MiniMax-H3",
            "MiniMax-H3-Max",
            "MiniMax-Hailuo-2.3"
          ],
          "type": "string"
        },
        "prompt": {
          "description": "Required video description, up to 7000 characters for MiniMax-H3 and MiniMax-H3-Max, and up to 3000 characters for MiniMax-Hailuo-2.3 (shorten it to fit). For MiniMax-H3 and MiniMax-H3-Max it also drives the native audio track (dialogue, ambience, sound effects).",
          "maxLength": 7000,
          "minLength": 1,
          "type": "string"
        },
        "ratio": {
          "description": "H3 family only. Text-to-video defaults to 16:9 and needs a concrete ratio. Keyframe mode always uses adaptive; reference mode defaults to adaptive.",
          "enum": [
            "adaptive",
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "type": "string"
        },
        "reference_audios": {
          "description": "MiniMax-H3 only. Supply 1-3 .wav or .mp3 audio references by URL, each no larger than 15 MB. Audio requires at least one reference image or video; across all reference collections at most 12 items are accepted. Cannot be combined with keyframes.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "mime_type": {
                "enum": [
                  "audio/wav",
                  "audio/x-wav",
                  "audio/mpeg",
                  "audio/mp3"
                ],
                "type": "string"
              },
              "url": {
                "description": "Use temp_url after completing upload_temp_url, or an existing upload URL from this environment.",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        },
        "reference_images": {
          "description": "MiniMax-H3 only. Supply 1-9 .jpg, .jpeg, .png, .webp, .heic, or .heif reference images by URL, each no larger than 30 MB. Across all reference collections at most 12 items are accepted. Cannot be combined with keyframes.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "mime_type": {
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/webp",
                  "image/heic",
                  "image/heif"
                ],
                "type": "string"
              },
              "url": {
                "description": "Use temp_url after completing upload_temp_url, or an existing upload URL from this environment.",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "minItems": 1,
          "type": "array"
        },
        "reference_type": {
          "description": "How input_image is used. H3 family supports first_frame or last_frame. MiniMax-Hailuo-2.3 supports first_frame and legacy subject mode (6s only).",
          "enum": [
            "first_frame",
            "last_frame",
            "subject"
          ],
          "type": "string"
        },
        "reference_videos": {
          "description": "MiniMax-H3 only. Supply 1-3 .mp4 or .mov reference videos by URL, each 2-15 seconds and no larger than 50 MB; their combined duration_seconds must not exceed 15. Every item must declare duration_seconds. Cannot be combined with keyframes.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "duration_seconds": {
                "description": "Required actual duration of the source video in whole seconds; used for validation and billing and not sent to the model.",
                "maximum": 15,
                "minimum": 2,
                "type": "integer"
              },
              "mime_type": {
                "enum": [
                  "video/mp4",
                  "video/quicktime"
                ],
                "type": "string"
              },
              "url": {
                "description": "Use temp_url after completing upload_temp_url, or an existing upload URL from this environment.",
                "type": "string"
              }
            },
            "required": [
              "url",
              "duration_seconds"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        },
        "resolution": {
          "description": "MiniMax-H3: 768P or 2K (default). MiniMax-H3-Max: 480P or 768P (default); 2K is not supported. MiniMax-Hailuo-2.3: 768P (default) for 6s or 10s, or 1080P for 6s only.",
          "enum": [
            "480P",
            "768P",
            "1080P",
            "2K"
          ],
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "model"
      ],
      "type": "object"
    }
  }
}
