{
  "id": "shot-template",
  "canvas": { "w": 1920, "h": 1080 },
  "fps": 30,
  "durationInFrames": 150,
  "style": "spec/style.json",
  "layers": [
    { "id": "bg", "type": "code", "draw": "grid", "rect": [0, 0, 1920, 1080], "z": 0 },
    { "id": "subject", "type": "ai", "asset": "subject-asset", "keyColor": "#ffffff", "blend": "multiply", "rect": [0, 0, 1920, 1080], "z": 1, "motion": { "type": "geometric", "zoom": [1.0, 1.06] } },
    { "id": "accent", "type": "code", "draw": "bar", "rect": [0, 880, 240, 70], "color": "#E03A3A", "z": 2, "motion": { "type": "geometric", "pan": [0, 540] } }
  ],
  "gates": [
    { "id": "motion", "metric": "changed_pixel_ratio", "lo": 0.0005, "hi": 0.08, "lumaDelta": 6 },
    { "id": "red", "metric": "red_pixel_ratio", "lo": 0.002, "hi": 0.02 },
    { "id": "keyPurity", "metric": "edge_key_purity", "lo": 0.98, "ring": 8, "tol": 12 }
  ]
}
